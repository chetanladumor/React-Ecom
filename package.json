    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
